/* Dark Theme for Trenex GUI */

QMainWindow {
    background-color: #2b2b2b;
    color: #ffffff;
}

QLabel {
    color: #ffffff;
}

QPushButton {
    background-color: #4a4a4a;
    color: #ffffff;
    border: none;
    padding: 5px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #6a6a6a;
}

QTextEdit {
    background-color: #1e1e1e;
    color: #ffffff;
}
